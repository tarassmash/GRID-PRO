# Скопируйте в .env и заполните. На Railway те же имена задаются в Variables.

# Ключ Bybit: права Read + Contract Trade, БЕЗ Withdrawal
BYBIT_API_KEY=
BYBIT_API_SECRET=
# testnet = учебный счёт, mainnet = реальные деньги
BYBIT_ENV=testnet

# Критический стоп-лосс, % от маржи позиции (ROI как на Bybit). 0 = выключен
STOP_LOSS_ROI=150

# Как часто проверять исполнение лимиток, секунд
POLL_SEC=2

# Telegram (необязательно): сообщения о микротейках, сдвигах сетки и стоп-лоссе
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Порт страницы (на компьютере откроется http://127.0.0.1:8080)
PORT=8080
