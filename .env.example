# На Railway эти имена задаются в Variables. Локально можно не задавать: ключи вводятся на странице.

# Пароль страницы бота (обязателен на сервере). Логин при входе любой.
APP_PASSWORD=

# Ключ Bybit: права «Спот торговля» и/или «Контракты», БЕЗ вывода средств
BYBIT_API_KEY=
BYBIT_API_SECRET=

# testnet = учебный счёт, demo = демо с реальными ценами, mainnet = реальные деньги
BYBIT_ENV=testnet

# Папка для настроек. На Railway подключите Volume с путём /data — бот найдёт его сам.
DATA_DIR=
